# Copy to .env and fill in values. Do not commit .env (keep secrets local).

# ─── CLOUDFLARE PUSH (Optional — leave blank to run local-only) ───────────────
# Get these after deploying: cd cloudflare && npx wrangler deploy
CF_WORKER_URL=https://abaya-track.YOUR_SUBDOMAIN.workers.dev
CF_INGEST_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_LIKE_uuid4

# Optional: catalog watcher PUT to localhost uses the same secret if unset
# CATALOG_INGEST_SECRET=same_as_above

# ─── LOCAL XLSX CATALOG (Optional) ───────────────────────────────────────────
# Path to an items_export.xlsx file the server should load automatically.
# Can be absolute (Windows path) or relative to the project root.
# Loaded at startup + every 24 h automatically.
# Override the interval (ms) with CATALOG_XLSX_INTERVAL_MS (min 3 600 000 = 1 h).
# Example Windows absolute path:
#   CATALOG_XLSX_PATH=C:\Users\DELL\Desktop\barcode\items_export.xlsx
CATALOG_XLSX_PATH=./docs/samples/items_export.xlsx 
# CATALOG_XLSX_INTERVAL_MS=86400000

# ─── LOCAL SERVER ─────────────────────────────────────────────────────────────
# Default in code is 3000
PORT=3000
