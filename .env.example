# Copy to .env and fill in values. Do not commit .env (keep secrets local).

# ─── CLOUDFLARE PUSH (Optional — leave blank to run local-only) ───────────────
# Deploy: cloudflare\DEPLOY.ps1 patches this from wrangler (see cloudflare/wrangler.toml).
# Public host for this repo’s Worker route is the custom domain below; workers.dev also works
# for the same worker name "abaya-track" if you use the URL Cloudflare shows after deploy.
# Optional WebSocket hardening: add a DNS-only (grey-cloud / not proxied) hostname to your
# factory origin for tablets — not the same as this Worker URL unless you terminate there.
CF_WORKER_URL=https://dashboard.farewellabaya.com
CF_INGEST_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_LIKE_uuid4

# When the factory has no internet, session_start / session_finish are written under ./data/
# (ceo-ingest-queue.jsonl) and auto-replayed when CF is back. Optional paths / interval:
# CEO_INGEST_QUEUE_DIR=C:/AbayaData/ceo-queue
# CEO_INGEST_QUEUE_FILE=./data/ceo-ingest-queue.jsonl
# CEO_INGEST_RETRY_INTERVAL_MS=30000

# Offline dashboard snapshot persistence (local disk, restart restore):
# OFFLINE_REPORT_DIR defaults to ./data/offline-dashboard-reports
# OFFLINE_RESTORE_MAX_AGE_MS unset = unlimited restore age (trust snapshot savedAt vs empty window)
# OFFLINE_LOG_WINDOW_MS unset = keep all logs in snapshot (still capped by STATE_LOG_MAX_ROWS)
# OFFLINE_SNAPSHOT_RETENTION_DAYS unset = keep latest snapshot file only (no pruning)
# Restored kiosk "in progress": drop rows older than RESTORE_ACTIVE_SESSION_MAX_AGE_MS (ms since started_at). If unset, server default is 48h.
# RESTORE_ACTIVE_SESSION_MAX_AGE_MS=
# OFFLINE_REPORT_DIR=C:/AbayaData/offline-dashboard-reports
# OFFLINE_RESTORE_MAX_AGE_MS=
# OFFLINE_LOG_WINDOW_MS=
# OFFLINE_SNAPSHOT_RETENTION_DAYS=

# ─── RECONCILIATION (cloud ↔ local) ───────────────────────────────────────────
# Periodically pulls /api/state from the Worker and re-pushes any local
# session events missing from D1. Local data is authoritative; cloud-only rows
# are recorded but never alter local state.
# RECONCILE_ENABLED=1
# RECONCILE_INTERVAL_MS=300000          # default 5 min, min 60s
# RECONCILE_MAX_REPUSH_PER_CYCLE=50

# ─── INGEST QUEUE BACKLOG ALERT THRESHOLDS ────────────────────────────────────
# CEO_INGEST_BACKLOG_THRESHOLD=25       # pending events that count as backlog
# CEO_INGEST_BACKLOG_DURATION_MS=600000 # 10 minutes; emit `queue-backlog` alert if held above

# ─── EMAIL ALERTS via Resend ──────────────────────────────────────────────────
# Triggers: cloud-auth-error, cloud-permanent-error, cloud-queue-backlog,
# reconcile-failure, snapshot-failure. Uses per-kind cooldown + global cap.
# Test wiring: POST http://localhost:PORT/api/alerts/test  (X-Ingest-Secret header)
# RESEND_API_KEY=
# ALERTS_TO=ops@example.com,ceo@example.com
# ALERTS_FROM=AbaYa Track <alerts@example.com>
# ALERTS_ENABLED=1
# ALERTS_DEDUP_MS=1800000               # 30 minutes between same-kind alerts
# ALERTS_MAX_PER_HOUR=8
# ALERTS_DRY_RUN=0                      # 1 = log only, no HTTP

# ─── AUTOMATED SQLite (.db) SNAPSHOTS ─────────────────────────────────────────
# A real SQLite file matching cloudflare/schema.sql is written automatically
# (atomic + rotated). Open with DB Browser for SQLite, sqlite3 CLI, or replay
# into Cloudflare D1 with: yarn snapshot:import --to-d1 [--remote]
# SQLITE_SNAPSHOT_ENABLED=1
# SQLITE_SNAPSHOT_DIR=./data/sqlite-snapshots
# SQLITE_SNAPSHOT_INTERVAL_MS=300000        # 5 minutes (min 30000)
# SQLITE_SNAPSHOT_RETENTION_DAYS=14         # prunes archive copies older than N days
#
# Tamper protection (recommended):
#   1. Set a strong random secret >=16 chars. Without it the manifest is unsigned.
#      SNAPSHOT_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
#   2. Run `yarn snapshot:harden` from an elevated PowerShell once to lock NTFS
#      ACLs on the snapshot directory (blocks non-admin delete/modify).
#   3. Run `yarn snapshot:verify` in a scheduled task to detect tampering.
# SNAPSHOT_SIGNING_SECRET=

# Optional: catalog watcher PUT to localhost uses the same secret if unset
# CATALOG_INGEST_SECRET=same_as_above

# Optional: simple pass employees type on the Photos & roster page (/asset-upload) to
# drag-and-drop the item-catalog Excel from any laptop on the factory Wi-Fi. Keep it
# separate from (and simpler than) CATALOG_INGEST_SECRET so you can share it with staff.
# If unset, the catalog upload falls back to accepting CATALOG_INGEST_SECRET / CF_INGEST_SECRET.
# CATALOG_UPLOAD_PASS=give_staff_a_simple_word

# Optional: CEO dashboard “Export floor data” (JSON/CSV). Defaults to CATALOG_INGEST_SECRET if unset.
# FLOOR_EXPORT_SECRET=same_as_or_different_from_above

# Optional: require this header for POST /api/upload/employee-image and catalog-item-image
# (factory PC). Leave blank to allow uploads from LAN without a secret.
# ASSET_UPLOAD_SECRET=your_random_string

# ─── LOCAL EXCEL FOLDER (Optional — factory PC) ────────────────────────────────
# One folder for both workbooks. Server loads:
#   {EXCEL_DATA_DIR}/items_export.xlsx  → catalog (barcode items)
#   {EXCEL_DATA_DIR}/employees.xlsx     → employees
# Use forward slashes on Windows. If you set CATALOG_XLSX_PATH or EMPLOYEES_XLSX_PATH
# below, those override the defaults for that file only.
# Example:
#   EXCEL_DATA_DIR=C:/Users/DELL/Desktop/barcode
EXCEL_DATA_DIR=

# Or set full paths instead of EXCEL_DATA_DIR (relative paths are from project root):
# CATALOG_XLSX_PATH=C:/Users/DELL/Desktop/barcode/items_export.xlsx
# EMPLOYEES_XLSX_PATH=C:/Users/DELL/Desktop/barcode/employees.xlsx
# CATALOG_XLSX_PATH=./docs/samples/items_export.xlsx
# EMPLOYEES_XLSX_PATH=./docs/samples/employees.xlsx

# Refresh interval (ms). Minimum 3600000 (1 hour) enforced in server.js.
# CATALOG_XLSX_INTERVAL_MS=86400000
# EMPLOYEES_XLSX_INTERVAL_MS=86400000

# Instant reload when items_export.xlsx / employees.xlsx change (chokidar). Set false to disable.
# EXCEL_FILE_WATCH=true

# When items_export has no Process column, server uses this (must match a real work type).
# DEFAULT_CATALOG_PROCESS=Tailor (01)

# ─── LOCAL SERVER ─────────────────────────────────────────────────────────────
# Bind address for the factory server. Use 0.0.0.0 for LAN access from tablets
# and phones on the same Wi-Fi; set to a fixed LAN IP such as 192.168.0.101 if
# you want the server to be reachable at a stable address.
HOST=0.0.0.0
PORT=3111

# Optional: force a specific LAN IP for tablet connections (e.g., 192.168.0.101)
# LAN_IP=192.168.0.101

# Electron Control Center (packaged launcher): prefer updates from this factory origin first.
# Server serves `/updates/stable/` and `/updates/beta/` from `data/lan-update-mirror/` (see docs/ONLINE_UPDATES.md).
# ABAYA_UPDATE_MIRROR_BASE_URL=http://192.168.1.10:3000
# Optional: store mirror files elsewhere on disk (server only)
# ABAYA_LAN_UPDATE_MIRROR_DIR=C:/AbayaData/lan-update-mirror

# Socket.IO engine ping tuning (optional; server defaults 15000 / 20000 ms)
# SOCKET_PING_INTERVAL_MS=15000
# SOCKET_PING_TIMEOUT_MS=20000

# ─── TAILSCALE (network layer — no env var needed) ───────────────────────────
# Tailscale IP is auto-detected by install\LAUNCH-ALL.bat.
# For catalog-watcher on office laptop, set employeesUrl in
# tools/catalog-watcher/config.json to http://<TAILSCALE_IP>:3000/api/employees
# Setup: install\SETUP-TAILSCALE.ps1 or docs\TAILSCALE_HYBRID.md
