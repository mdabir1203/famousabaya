# Copy to .env and fill in values. Do not commit .env (keep secrets local).

# ─── CLOUDFLARE PUSH (Optional — leave blank to run local-only) ───────────────
# Deploy: cloudflare\DEPLOY.ps1 patches this from wrangler (see cloudflare/wrangler.toml).
# Public host for this repo’s Worker route is the custom domain below; workers.dev also works
# for the same worker name "abaya-track" if you use the URL Cloudflare shows after deploy.
# Optional WebSocket hardening: add a DNS-only (grey-cloud / not proxied) hostname to your
# factory origin for tablets — not the same as this Worker URL unless you terminate there.
CF_WORKER_URL=https://dashboard.farewellabaya.com
CF_INGEST_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_LIKE_uuid4

# When the factory has no internet, session_start / session_finish are written under ./data/
# (ceo-ingest-queue.jsonl) and auto-replayed when CF is back. Optional paths / interval:
# CEO_INGEST_QUEUE_DIR=C:/AbayaData/ceo-queue
# CEO_INGEST_QUEUE_FILE=./data/ceo-ingest-queue.jsonl
# CEO_INGEST_RETRY_INTERVAL_MS=30000

# Optional: replay offline queue via POST /api/sync/v1/batch (HMAC) when flushing 2+ events (see docs/DOMAIN_CONTRACT.md).
# CF_SYNC_USE_BATCH=1

# Optional: persist active sessions + completed logs + perf on disk (SQLite under ./data/). Set LOCAL_SQLITE=0 to disable.
# Use `yarn start` (not plain `node server.js`) so Yarn PnP can load better-sqlite3.
# LOCAL_SQLITE_DIR=./data

# Optional: catalog watcher PUT to localhost uses the same secret if unset
# CATALOG_INGEST_SECRET=same_as_above

# Optional: require this header for POST /api/upload/employee-image and catalog-item-image
# (factory PC). Leave blank to allow uploads from LAN without a secret.
# ASSET_UPLOAD_SECRET=your_random_string

# ─── LOCAL EXCEL FOLDER (Optional — factory PC) ────────────────────────────────
# One folder for both workbooks. Server loads:
#   {EXCEL_DATA_DIR}/items_export.xlsx  → catalog (barcode items)
#   {EXCEL_DATA_DIR}/employees.xlsx     → employees
# Use forward slashes on Windows. If you set CATALOG_XLSX_PATH or EMPLOYEES_XLSX_PATH
# below, those override the defaults for that file only.
# Example:
#   EXCEL_DATA_DIR=C:/Users/DELL/Desktop/barcode
EXCEL_DATA_DIR=

# Or set full paths instead of EXCEL_DATA_DIR (relative paths are from project root):
# CATALOG_XLSX_PATH=C:/Users/DELL/Desktop/barcode/items_export.xlsx
# EMPLOYEES_XLSX_PATH=C:/Users/DELL/Desktop/barcode/employees.xlsx
# CATALOG_XLSX_PATH=./docs/samples/items_export.xlsx
# EMPLOYEES_XLSX_PATH=./docs/samples/employees.xlsx

# Refresh interval (ms). Minimum 3600000 (1 hour) enforced in server.js.
# CATALOG_XLSX_INTERVAL_MS=86400000
# EMPLOYEES_XLSX_INTERVAL_MS=86400000

# When items_export has no Process column, server uses this (must match a real work type).
# DEFAULT_CATALOG_PROCESS=Tailor (01)

# ─── LOCAL SERVER ─────────────────────────────────────────────────────────────
PORT=3000

# Socket.IO engine ping tuning (optional; server defaults 15000 / 20000 ms)
# SOCKET_PING_INTERVAL_MS=15000
# SOCKET_PING_TIMEOUT_MS=20000

# ─── TAILSCALE (network layer — no env var needed) ───────────────────────────
# Tailscale IP is auto-detected by install\LAUNCH-ALL.bat.
# For catalog-watcher on office laptop, set employeesUrl in
# tools/catalog-watcher/config.json to http://<TAILSCALE_IP>:3000/api/employees
# Setup: install\SETUP-TAILSCALE.ps1 or docs\TAILSCALE_HYBRID.md
