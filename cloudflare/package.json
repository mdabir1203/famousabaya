{
  "name": "abaya-track-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":    "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create abaya-db",
    "db:init":   "wrangler d1 execute abaya-db --file=schema.sql",
    "db:init:remote": "wrangler d1 execute abaya-db --remote --file=schema.sql",
    "secrets": "echo 'Run: wrangler secret put INGEST_SECRET && wrangler secret put CEO_TOKEN'"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
