{
  "name": "abaya-design-flow-video",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion video that walks through the AbaYa Track architecture (docs/SYSTEM_DESIGN.md) with Hollywood-grade cinematography.",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render AbaYaDesignFlow out/abaya-design-flow.mp4 --concurrency=1",
    "render:preview": "MOTION_BLUR=0 remotion render AbaYaDesignFlow out/abaya-design-flow-preview.mp4 --scale=0.5 --concurrency=1",
    "render:final": "remotion render AbaYaDesignFlow out/abaya-design-flow.mp4 --concurrency=1",
    "still": "remotion still AbaYaDesignFlow",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.457",
    "@remotion/cli": "^4.0.457",
    "@remotion/media": "^4.0.457",
    "@remotion/motion-blur": "^4.0.457",
    "@remotion/renderer": "^4.0.457",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.457"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
