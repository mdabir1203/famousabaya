# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*
# Allow the committed sanitized template that CI materializes into
# install/.env.production on every release. The template carries NO secrets
# (no GH_TOKEN, no CF_INGEST_SECRET) — only non-sensitive defaults.
!.env.*.template
!install/.env.production.template

# Editors
.vscode/
.idea/

# Logs and temp files
*.log
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

