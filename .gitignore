# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Cloudflare Workers (local dev secrets + cache) ───────────────────────────
cloudflare/.dev.vars
.wrangler/

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
tools/desktop-launcher/out/
tools/desktop-launcher/dist/
*.tsbuildinfo

# Desktop launcher runs on the node-modules linker; its regenerable Yarn state
# (install-state.gz, cache) must not be tracked. Root `.yarn/*` is path-anchored
# and does not reach this subdirectory, so ignore it explicitly.
tools/desktop-launcher/.yarn/
# Portable Node.js downloaded by START.bat on machines without a system Node.
/.bin/
# Runner files generated at install time by install/lib/bootstrap.cjs.
install/run-*.bat
install/silent-*.vbs

# ─── Regenerable artifacts (binary in git ⇒ merge conflicts) ──────────────────
# SQLite snapshots are rebuilt by shared/sqlite-snapshot.cjs — never commit the .db.
data/sqlite-snapshots/*.db
# Generic logs (specific log paths kept below for clarity)
*.log

# ─── Legacy npm (no longer used — Yarn PnP is used instead) ──────────────────
node_modules/
package-lock.json

# ─── Yarn Berry / PnP (NON zero-install) ──────────────────────────────────────
# Generated files that MUST NOT be committed — they are rebuilt by `yarn install`
# and otherwise cause merge conflicts (.pnp.*) and oversized history (.yarn/cache,
# e.g. a 72 MB workerd zip that broke `git push`). Patterns are non-anchored so
# they apply to every workspace (root, cloudflare/, tools/*, docs/*).
#
# Tracked (do NOT ignore): yarn.lock, .yarnrc.yml, and .yarn/{releases,plugins,
# patches,sdks,versions} — the parts a fresh `yarn install` needs.
#
# To re-enable zero-installs later: un-ignore .yarn/cache below and run
# `yarn config set enableGlobalCache false`. https://yarnpkg.com/features/caching
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
# !.yarn/cache          # ← uncomment only for a zero-install setup
.pnp.*

# ─── Catalog watcher live config (may contain secrets / real employee data) ───
tools/catalog-watcher/config.json

# ─── CEO ingest offline queue (session events; do not commit) ─────────────────
data/ceo-ingest-queue.jsonl
data/ceo-ingest-queue.jsonl.draining

# ─── Debug / local instrumentation (Cursor IDE, install probes) ──────────────
.cursor/debug*.log
/debug-*.log

# ─── Offline dashboard snapshots (regenerated by server) ───────────────────
data/offline-dashboard-reports/dashboard-offline-*.json
data/desktop-launcher/

# ─── LAN Electron launcher update mirror (publish installers locally; do not commit) ─
data/lan-update-mirror/stable/*
data/lan-update-mirror/beta/*
!data/lan-update-mirror/stable/.gitkeep
!data/lan-update-mirror/beta/.gitkeep

# ─── Uploaded media (employee / item photos; keep .gitkeep only) ───────────────
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/employees/
!/public/uploads/items/
/public/uploads/employees/*
!/public/uploads/employees/.gitkeep
/public/uploads/items/*
!/public/uploads/items/.gitkeep

# ─── Local scratch (not part of repo) ─────────────────────────────────────────
/New folder/

# ─── QA run logs (regenerate locally; paths may expose machine/username) ──────
qa/server-smoke.err.log
qa/server-smoke.out.log

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.lnk
desktop.ini
