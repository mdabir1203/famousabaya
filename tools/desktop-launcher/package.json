{
  "name": "abaya-desktop-launcher",
  "version": "1.2.5",
  "private": true,
  "description": "Single EXE installer and launcher for the full AbaYa Track runtime",
  "author": "Mohammad Abir Abbas",
  "main": "main.js",
  "scripts": {
    "start": "node -r ./.pnp.cjs ./start-electron.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "release:gh": "electron-builder --win nsis --x64 --publish always"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^24.13.3",
    "supports-color": "^9.0.0"
  },
  "build": {
    "appId": "com.abaya.track.launcher",
    "productName": "AbaYa Track Launcher",
    "directories": {
      "output": "../../dist/desktop-launcher"
    },
    "icon": "assets/app-icon",
    "files": [
      "index.html",
      "main.js",
      "update-policy.cjs",
      "preload.js",
      "renderer.js",
      "start-electron.cjs",
      "package.json",
      "../../package.json",
      "../../yarn.lock",
      "../../.yarnrc.yml",
      "../../.pnp.cjs",
      "../../.env.example",
      "../../tools/catalog-watcher/config.example.json",
      "../../.yarn/**/*",
      "../../install/**/*",
      "../../server.js",
      "../../scripts/**/*",
      "../../shared/**/*",
      "../../services/**/*",
      "../../cloudflare/**/*",
      "../../config/**/*",
      "../../docs/**/*",
      "../../lib/**/*",
      "../../public/**/*",
      "../../tools/**/*",
      "../../gk/**/*",
      "../../objects/**/*",
      "../../data/**/*",
      "../../node_modules/**/*",
      "../../tools/catalog-watcher/node_modules/**/*",
      "../../*.md",
      "../../*.txt",
      "../../*.json",
      "../../*.cjs",
      "../../*.mjs",
      "../../*.js",
      "../../*.bat",
      "../../*.ps1",
      "../../*.sql",
      "../../*.xlsx",
      "../../ecosystem.config.cjs",
      "../../wrangler.jsonc",
      "../../docker/**/*",
      "../../product-explainer/**/*",
      "../../kiosk-pwa/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mdabir1203",
        "repo": "famousabaya",
        "releaseType": "release"
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${channel}-${arch}.${ext}",
      "icon": "assets/app-icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "installerSidebar": "assets/app-icon.ico",
      "artifactName": "AbaYa-Track-Launcher-Setup-${version}.exe"
    }
  }
}
