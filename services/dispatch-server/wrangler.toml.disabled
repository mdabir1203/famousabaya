# ─────────────────────────────────────────────────────────────────────────────
# DISABLED — do not deploy from this folder.
#
# This file used to declare a separate "abaya-dispatch-worker" whose
# `main = "cloud-worker/index.js"` entry-point was never written, which made
# `wrangler deploy` fail here with:
#   X [ERROR] The entry-point file at "cloud-worker\index.js" was not found.
#
# The dispatch edge (WhatsApp webhook + invoice bridge) lives in the MAIN Worker
# (cloudflare/src/handlers/dispatch.js, wired in cloudflare/src/index.js). Deploy
# from ../../cloudflare/ instead:
#   cd ../../cloudflare && npx wrangler deploy
# Routes go live at https://dashboard.farewellabaya.com/dispatch/*
#
# Kept (renamed to .disabled) only as a reference for the D1 binding below, which
# is already covered by ../../cloudflare/wrangler.toml (same database_id).
# ─────────────────────────────────────────────────────────────────────────────

name = "abaya-dispatch-worker"
# main = "cloud-worker/index.js"   # never existed — folded into ../../cloudflare/src/handlers/dispatch.js
compatibility_date = "2024-11-01"

[[d1_databases]]
binding       = "DB"
database_name = "abaya-db"
database_id   = "5d61fb15-2ead-491b-80e2-fe2b2fd46d23"
