# ─── Dispatch Server Configuration ───────────────────────────────────────────

# Port for the Bun dispatch server (must NOT conflict with main server.js port)
DISPATCH_PORT=3111

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Your Meta app's permanent access token
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here

# A random string you define — must match what you set in the Meta Developer Console webhook config
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Your WhatsApp Business Account phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret header required on POST /api/invoices (prevents rogue pushes)
DISPATCH_INGEST_SECRET=change_me_to_a_strong_random_secret

# ─── Cloud ↔ Factory Bridge ────────────────────────────────────────────────────
# URL of your main Cloudflare Worker (no trailing slash).
# Used by the factory server to push step1/step2 status updates to D1.
CF_WORKER_URL=https://dashboard.farewellabaya.com

# Shared secret between Cloudflare Worker and factory server.
# Must match the DISPATCH_BRIDGE_SECRET Wrangler secret on the Worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DISPATCH_BRIDGE_SECRET=change_me_generate_a_random_hex_string

# ─── Mobile SIM / Public Access ───────────────────────────────────────────────
# Public URL where tablets can reach this server from outside the LAN.
# Required when devices connect over mobile data (UAE Etisalat/du CGNAT means
# the laptop has no public IP — tablets MUST use this tunnel URL).
# Set up: install cloudflared, run: cloudflared tunnel --url http://localhost:3111
# Then set this to the assigned subdomain, e.g.:
#   PUBLIC_URL=https://factory.farewellabaya.com
# Leave blank if all tablets are always on the same WiFi/hotspot as the laptop.
PUBLIC_URL=https://factory.farewellabaya.com

# ─── Read access token (REQUIRED when PUBLIC_URL is set) ──────────────────────
# Without this, the leaderboard's read endpoints (invoices, server info, the live
# SSE stream, audio voice notes) are OPEN — anyone who learns the tunnel URL can
# read every supplier name, material, and customer note.
# When set, those endpoints require this token. Tablets open the leaderboard as:
#   https://factory.farewellabaya.com/leaderboard?token=<this value>
# The page stores the token and reuses it for all data/stream/audio calls.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank ONLY for LAN-only deployments (no public tunnel).
DISPATCH_VIEW_TOKEN=

# ─── Observability / SkyWalking APM ───────────────────────────────────────────
# Enables distributed tracing + metrics. The agent is loaded by ecosystem.config.cjs
# via `node --import ./sw-instrument.mjs`. See docs/OBSERVABILITY.md.
#
# Set to the OAP gRPC address to ENABLE tracing; leave blank to DISABLE (zero overhead).
# OAP runs in Docker — start it with observability/start.bat (listens on localhost:11800).
SW_AGENT_COLLECTOR_BACKEND_SERVICES=localhost:11800
# Name shown in the SkyWalking UI (groups all instances of this service together).
SW_AGENT_NAME=abaya-dispatch
# Identifies this specific process/machine in the UI.
SW_AGENT_INSTANCE_NAME=factory-laptop
