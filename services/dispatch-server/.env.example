# ─── Dispatch Server Configuration ───────────────────────────────────────────

# Port for the Bun dispatch server (must NOT conflict with main server.js port)
DISPATCH_PORT=3001

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Your Meta app's permanent access token
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here

# A random string you define — must match what you set in the Meta Developer Console webhook config
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# Your WhatsApp Business Account phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret header required on POST /api/invoices (prevents rogue pushes)
DISPATCH_INGEST_SECRET=change_me_to_a_strong_random_secret

# ─── Cloud ↔ Factory Bridge ────────────────────────────────────────────────────
# URL of your main Cloudflare Worker (no trailing slash).
# Used by the factory server to push step1/step2 status updates to D1.
CF_WORKER_URL=https://dashboard.farewellabaya.com

# Shared secret between Cloudflare Worker and factory server.
# Must match the DISPATCH_BRIDGE_SECRET Wrangler secret on the Worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DISPATCH_BRIDGE_SECRET=change_me_generate_a_random_hex_string

# ─── Mobile SIM / Public Access ───────────────────────────────────────────────
# Public URL where tablets can reach this server from outside the LAN.
# Required when devices connect over mobile data (UAE Etisalat/du CGNAT means
# the laptop has no public IP — tablets MUST use this tunnel URL).
# Set up: install cloudflared, run: cloudflared tunnel --url http://localhost:3001
# Then set this to the assigned subdomain, e.g.:
#   PUBLIC_URL=https://factory.farewellabaya.com
# Leave blank if all tablets are always on the same WiFi/hotspot as the laptop.
PUBLIC_URL=https://factory.farewellabaya.com
