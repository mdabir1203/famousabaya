# ─── LOCAL SERVER ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3111

# Optional: force a specific LAN IP for tablet connections
LAN_IP=192.168.0.105

# ─── SOCKET.IO TUNING ───────────────────────────────────────────────────────────
# Relaxed defaults for factory Wi-Fi jitter tolerance
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=60000

# ─── TCP KEEP-ALIVE ─────────────────────────────────────────────────────────────
# Prevents Android Chrome ERR_CONNECTION_ABORTED on idle sockets
SERVER_KEEP_ALIVE_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=130000

# ─── CLOUDFLARE PUSH ────────────────────────────────────────────────────────────
# Worker base + ingest secret for the cloud dashboard sync. These ARE bundled
# in the install on purpose — fresh installs need them to authenticate against
# dashboard.farewellabaya.com. Rotate by updating the Worker and re-releasing.
CF_WORKER_URL=https://dashboard.farewellabaya.com
CF_INGEST_SECRET=abaya2026

# ─── LOCAL EXCEL FOLDER ──────────────────────────────────────────────────────────
EXCEL_DATA_DIR=

# ─── ELECTRON LAUNCHER UPDATES ──────────────────────────────────────────────────
# LAN mirror base URL for desktop launcher auto-updates (preferred over GitHub)
# Format: http://<LAN_IP>:<PORT> - no trailing slash
# In dev, override to http://127.0.0.1:<PORT> to point at the local server.
ABAYA_UPDATE_MIRROR_BASE_URL=http://192.168.0.105:3111

# Cloud (R2) OTA feed base URL — used as the primary fallback when the LAN
# mirror is unreachable (off-site laptops, factory down, IP changed).
# The launcher fetches <base>/updates/<channel>/latest.yml from this URL.
# Defaults to the Worker custom domain if unset.
ABAYA_CLOUD_UPDATE_BASE_URL=https://dashboard.farewellabaya.com

# LAN-shared photo folder for cross-laptop item/employee photo sync (v1.2.13+).
# Created automatically if missing. Each laptop in the factory points at
# the same path (or a UNC to it). Leave empty to disable LAN replication
# (cloud R2 replication still runs).
ABAYA_LAN_ASSETS_DIR=C:\AbayaData\shared\items

# Optional: store mirror files elsewhere on disk (server only)
# ABAYA_LAN_UPDATE_MIRROR_DIR=C:/AbayaData/lan-update-mirror

# GitHub token intentionally NOT bundled. The release CI uses $GH_PAT secret;
# the runtime factory server has no need for it. If a future build script
# looks for GH_TOKEN in this file, inject it via the build environment instead.
