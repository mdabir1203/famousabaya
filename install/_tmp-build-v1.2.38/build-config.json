{
    "appId":  "com.abaya.track.launcher",
    "productName":  "AbaYa Track Launcher",
    "directories":  {
                        "output":  "../../install/_tmp-build-v1.2.38/app"
                    },
    "icon":  "assets/app-icon",
    "files":  [
                  "index.html",
                  "main.js",
                  "update-policy.cjs",
                  "env-migrate.cjs",
                  "preload.js",
                  "renderer.js",
                  "start-electron.cjs",
                  "package.json",
                  "app-update.yml",
                  "dev-app-update.yml",
                  "README.md"
              ],
    "fileAssociations":  [

                         ],
    "extraResources":  [
                           {
                               "from":  "../../install",
                               "to":  "install",
                               "filter":  [
                                              "*.bat",
                                              "*.ps1",
                                              "*.cjs"
                                          ]
                           },
                           {
                               "from":  "../../scripts",
                               "to":  "scripts",
                               "filter":  [
                                              "*.ps1"
                                          ]
                           },
                           {
                               "from":  "../../server.js",
                               "to":  "server.js"
                           },
                           {
                               "from":  "../../package.json",
                               "to":  "package.json"
                           },
                           {
                               "from":  "../../.env.example",
                               "to":  ".env.example"
                           },
                           {
                               "from":  "../../install/.env.production",
                               "to":  ".env.production"
                           },
                           {
                               "from":  "../../ecosystem.config.cjs",
                               "to":  "ecosystem.config.cjs"
                           },
                           {
                               "from":  "../../public",
                               "to":  "public",
                               "filter":  [
                                              "**/*.{html,js,css,png,jpg,jpeg,svg,ico,json}"
                                          ]
                           },
                           {
                               "from":  "../../shared",
                               "to":  "shared",
                               "filter":  [
                                              "**/*.{js,cjs,mjs}"
                                          ]
                           },
                           {
                               "from":  "../../config",
                               "to":  "config",
                               "filter":  [
                                              "**/*.json",
                                              "**/*.yml",
                                              "**/*.yaml"
                                          ]
                           },
                           {
                               "from":  "../../tools/catalog-watcher",
                               "to":  "tools/catalog-watcher",
                               "filter":  [
                                              "*.js",
                                              "*.json",
                                              "*.cjs",
                                              "*.mjs",
                                              "*.txt",
                                              "package.json",
                                              "yarn.lock",
                                              "node_modules/**/*"
                                          ]
                           },
                           {
                               "from":  ".factory-deps/node_modules",
                               "to":  "node_modules"
                           }
                       ],
    "publish":  [
                    {
                        "provider":  "github",
                        "owner":  "mdabir1203",
                        "repo":  "famousabaya",
                        "releaseType":  "release"
                    }
                ],
    "extraMetadata":  {
                          "main":  "main.js"
                      },
    "win":  {
                "target":  [
                               {
                                   "target":  "nsis",
                                   "arch":  [
                                                "x64"
                                            ]
                               }
                           ],
                "artifactName":  "AbaYa-Track-Launcher-Setup-${version}.${ext}",
                "verifyUpdateCodeSignature":  false
            },
    "nsis":  {
                 "oneClick":  false,
                 "allowToChangeInstallationDirectory":  true,
                 "perMachine":  false,
                 "createDesktopShortcut":  true,
                 "createStartMenuShortcut":  true,
                 "shortcutName":  "AbaYa Track Launcher"
             }
}
